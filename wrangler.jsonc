{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "fotoviagem",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "STICKERS",
      "id": "265e088c512645c687a50145b4b0ab80"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STICKERS_FILES",
      "bucket_name": "fotoviagem-lettering"
    }
  ],
  "observability": {
    "enabled": true
  }
}